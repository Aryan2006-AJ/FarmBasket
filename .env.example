# Copy to .env and edit. Nothing here is required for local development,
# but every line marked LAUNCH must be set before the site goes public.

# LAUNCH: long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
FARMBASKET_SECRET_KEY=

# LAUNCH: shown on the Privacy Policy and Terms pages and in the footer
FARMBASKET_BUSINESS_NAME=FarmBasket
FARMBASKET_SUPPORT_EMAIL=

# Optional: city/state whose courts govern the Terms, shown on the Terms page if set
FARMBASKET_JURISDICTION=

# LAUNCH: set to true when the site is served over HTTPS (marks the session cookie Secure)
FARMBASKET_HTTPS=false

# Set to true only on your own machine. Never enable on a public server.
FARMBASKET_DEBUG=false

RATELIMIT_STORAGE_URI=memory://
